{# unmet_detail.html.j2 — TL Unmet Target Detail + Agent Drilldown #}
{# Phase 4b.4 #}
<!-- TL Unmet Detail -->
<div id="tl-unmet-section" style="display: none;">
    <div class="card">
        <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 16px; color: #991b1b;">Unmet Target — Detail Review</h3>
        <div style="display: flex; gap: 12px; margin-bottom: 20px;">
            <div class="metric-card" style="flex: 1;">
                <div class="metric-value" id="tl-gap-amount">--</div>
                <div class="metric-label">Gap to Target</div>
                <div id="tl-gap-meta" style="font-size: 12px; color: #64748b; margin-top: 4px;">Target: -- | Actual: --</div>
            </div>
            <div class="metric-card" style="flex: 1;">
                <div class="metric-value" id="tl-call-gap">--</div>
                <div class="metric-label">Call Volume Gap</div>
                <div id="tl-call-gap-meta" style="font-size: 12px; color: #64748b; margin-top: 4px;">Target: -- | Actual: --</div>
            </div>
            <div class="metric-card" style="flex: 1;">
                <div class="metric-value" id="tl-connect-gap">--</div>
                <div class="metric-label">Call Billmin Gap</div>
                <div id="tl-connect-gap-meta" style="font-size: 12px; color: #64748b; margin-top: 4px;">Target: -- | Actual: --</div>
            </div>
            <div class="metric-card" style="flex: 1;">
                <div class="metric-value" id="tl-attendance-rate">--</div>
                <div class="metric-label">Attendance</div>
            </div>
        </div>
        <h4 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Agent Level Drill-down</h4>
        <div style="display:flex; gap:8px; align-items:center; margin-bottom:10px;">
            <button id="tl-breakdown-toggle" onclick="toggleTLBreakdown()" style="padding:6px 10px; border:1px solid #cbd5e1; border-radius:6px; background:#fff; cursor:pointer; font-size:12px;">Show Breakdown</button>
            <div id="tl-breakdown-dim-toggle" style="display:none; align-items:center; gap:8px; padding:4px 8px; border:1px solid #bfdbfe; border-radius:8px; background:#eff6ff;">
                <span id="tl-breakdown-dim-label" style="font-size:12px; color:#1e40af; font-weight:600;">Dimension</span>
                <button type="button" id="tl-breakdown-dim-overdue" onclick="setTLBreakdownDimension('caseStage')" style="padding:5px 10px; border:1px solid #93c5fd; border-radius:6px; background:#fff; cursor:pointer; font-size:12px; color:#1d4ed8;">Overdue Stage</button>
                <button type="button" id="tl-breakdown-dim-principal" onclick="setTLBreakdownDimension('principalStage')" style="padding:5px 10px; border:1px solid #93c5fd; border-radius:6px; background:#fff; cursor:pointer; font-size:12px; color:#1d4ed8;">Principal Band</button>
            </div>
        </div>
        <div id="tl-breakdown-panel" data-dim="caseStage" style="display:none; margin-bottom:12px;">
            <div style="display:none; border:1px solid #e2e8f0; border-radius:8px; padding:10px; margin-bottom:10px; background:#f8fafc;">
                <div id="tl-breakdown-mix-title" style="font-size:12px; color:#334155; font-weight:600; margin-bottom:6px;">Dimension Mix</div>
                <table style="width:100%; border-collapse:collapse;">
                    <thead>
                        <tr style="border-bottom:1px solid #e2e8f0;">
                            <th id="tl-breakdown-mix-dim-header" style="padding:6px; text-align:left; font-size:12px; color:#64748b;">Overdue Stage</th>
                            <th style="padding:6px; text-align:right; font-size:12px; color:#64748b;">Owing Principal</th>
                            <th id="tl-breakdown-mix-share-header" style="padding:6px; text-align:right; font-size:12px; color:#64748b;">Owing Share</th>
                        </tr>
                    </thead>
                    <tbody id="tl-breakdown-mix-table"></tbody>
                </table>
            </div>
            <div style="margin-bottom:10px;">
                <div id="tl-breakdown-share-title" style="font-size:12px; color:#334155; font-weight:600; margin:0 0 6px 0;">Owing Share Pivot</div>
                <table style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                    <thead>
                        <tr id="tl-breakdown-share-head-row" style="background:#f8fafc; border-bottom:1px solid #e2e8f0;"></tr>
                    </thead>
                    <tbody id="tl-breakdown-share-table"></tbody>
                </table>
            </div>
            <div style="margin-bottom:8px;">
                <div id="tl-breakdown-rate-title" style="font-size:12px; color:#334155; font-weight:600; margin:0 0 6px 0;">Repay Rate Pivot</div>
                <table style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                    <thead>
                        <tr id="tl-breakdown-rate-head-row" style="background:#f8fafc; border-bottom:1px solid #e2e8f0;"></tr>
                    </thead>
                    <tbody id="tl-breakdown-rate-table"></tbody>
                </table>
            </div>
            <div id="tl-breakdown-empty" style="display:none; font-size:12px; color:#64748b;">No breakdown data for selected date.</div>
        </div>
        <p style="font-size: 12px; color: #64748b; margin-bottom: 12px;">
            <span style="display: inline-block; width: 12px; height: 12px; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 2px; margin-right: 4px;"></span>3+ consecutive unmet days &nbsp;
            <span style="display: inline-block; width: 12px; height: 12px; background: #fffbeb; border: 1px solid #fcd34d; border-radius: 2px; margin-right: 4px;"></span>1–2 consecutive unmet days
        </p>
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                    <th style="padding: 12px; text-align: left; font-size: 12px; color: #64748b;">Agent</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; color: #64748b;" title="Fail to reach target X days in a row">Fail to meet target</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Target set for the day / 当日设定目标值">Target</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Actual achieved in the day / 当日实际完成值">Actual</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Achievement ratio, ≥100% = on track / 达成比例，≥100% 为达标">Achievement</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; color: #64748b;" title="Attendance means working full 8h / 出勤意为工作满8h">On Duty (8h)</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Call connect rate / 电话接通率 = 成功接通数 / 拨打数 × 100%">Conn. Rate</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Cover times per case / 每案件平均覆盖次数">Cover Times</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Agent's avg. daily dial count / 催员平均每天拨打电话次数">Call Times</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Agent's avg. daily manual dial count / 催员平均每天人工拨号次数">Art Call Times</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Agent's avg. daily connected time (minutes) / 催员平均每天接通时长（分钟）">Call Billmin</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Avg. connected time per call (minutes) / 平均单通接通时长（分钟）= 总通话分钟数 / 通话次数">Single Call Duration</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Users who promised to pay / Users who should repay × 100% / 承诺还款率 = 承诺还款用户数 / 应还款用户数 × 100%">PTP</th>
                    <th style="padding: 12px; text-align: right; font-size: 12px; color: #64748b;" title="Call loss rate / 呼损率 = 成功接通数 / 用户接听数 × 100%">Call Loss</th>
                    <th style="padding: 12px; text-align: center; font-size: 12px; color: #64748b;" title="Process execution KPI composite / 流程执行综合指标">Process KPI</th>
                </tr>
            </thead>
            <tbody id="tl-agent-table"></tbody>
        </table>
    </div>
</div>
