{# metrics.html.j2 — TL Metrics cards #}
{# Phase 4b.2 #}
<!-- TL Metrics (hidden until group selected) -->
<div id="tl-metrics-container" style="display: none;">
    <div class="card">
        <div style="display: flex; gap: 12px; margin-bottom: 20px;">
            <div class="metric-card" style="flex: 1;">
                <div class="metric-value" id="tl-yesterday-target">--</div>
                <div class="metric-label">Target</div>
            </div>
            <div class="metric-card" style="flex: 1;">
                <div class="metric-value" id="tl-yesterday-actual">--</div>
                <div class="metric-label">Actual</div>
            </div>
            <div class="metric-card" style="flex: 1;">
                <div class="metric-value" id="tl-achievement-rate">--%</div>
                <div class="metric-label">Achievement Rate</div>
            </div>
            <div class="metric-card" style="flex: 1;">
                <div class="metric-value" id="tl-module-avg">--%</div>
                <div class="metric-label">vs Module Avg</div>
            </div>
        </div>
        <div id="tl-status-badge"></div>
    </div>
</div>
